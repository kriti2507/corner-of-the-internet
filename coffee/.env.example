# Comments are stored in Vercel Blob. Vercel sets this when the Blob store is
# connected to the project. Without it, comments show as "coming soon" locally.
BLOB_READ_WRITE_TOKEN=

# Password for /coffee/admin, where you can delete comments and reply as Kriti.
ADMIN_TOKEN=

# Optional: email Kriti when someone comments (same Resend key as the main site).
RESEND_API_KEY=
COMMENTS_NOTIFY_EMAIL=ping@heykriti.com
COMMENTS_FROM_EMAIL="Coffee notebook <ping@heykriti.com>"
