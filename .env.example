# The contact form sends through Resend (https://resend.com).
# Verify heykriti.com in Resend, then set RESEND_API_KEY in Vercel.
# Notes go to site.email (ping@heykriti.com) from "Kriti's site <ping@heykriti.com>"
# unless the two overrides below are set. Without a key, the form logs the note
# locally and shows the mailto fallback in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
